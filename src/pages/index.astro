---
import BaseLayout from '../layouts/BaseLayout.astro';
import TimezoneConverter from '../components/TimezoneConverter.astro';
import TimelineSlider from '../components/TimelineSlider.astro';
import MeetingPlanner from '../components/MeetingPlanner.astro';

const features = [
  'Golden Hour Meeting Planner',
  '24-Hour Timeline Slider',
  'Interactive World Map',
  'Simultaneous Multi-City Sync',
  'All 38 Timezones',
  'One-Click Calendar Invites'
];

const steps = [
  { 
    step: '1', 
    title: 'Select or Add Cities', 
    body: 'Pick from popular team routes (e.g. London ⇄ Tokyo, SF ⇄ Sydney) or add custom global cities to compare schedules.' 
  },
  { 
    step: '2', 
    title: 'Find Golden Working Overlaps', 
    body: 'Our algorithm automatically highlights top recommended Golden Windows where all team members are in business hours (9 AM – 5 PM).' 
  },
  { 
    step: '3', 
    title: 'Export Invites with 1 Click', 
    body: 'Generate instant Google Calendar and Outlook links, download .ICS files, or copy bulleted local time summaries for Slack and email.' 
  },
];

const pageLinks = [
  { href: '/about',          label: 'About us',           sub: 'Our mission & story' },
  { href: '/contact',        label: 'Contact us',          sub: 'Feedback & support' },
  { href: '/privacy-policy', label: 'Privacy policy',      sub: 'How we respect data' },
  { href: '/terms',          label: 'Terms of service',    sub: 'Usage guidelines' },
];

const faqItems = [
  {
    q: 'How does the "Golden Hour" Meeting Planner find overlapping working hours?',
    a: 'The Golden Hour Planner analyzes the local time of all selected cities across every hour of your chosen date. It scores each time slot based on availability (Green for 9 AM–5 PM business hours, Yellow for 7–9 AM & 5–8 PM flexible hours, Red for 8 PM–7 AM sleep) and automatically recommends the top overlapping windows where all participants are awake and working.'
  },
  {
    q: 'What is the best meeting time between London and Tokyo?',
    a: 'Because London (UTC+0 / UTC+1) and Tokyo (UTC+9) are 8 to 9 hours apart, the optimal "Golden Hour" overlap occurs between 8:00 AM – 9:00 AM London time, which corresponds to 5:00 PM – 6:00 PM Tokyo time (or 4:00 PM – 5:00 PM during British Summer Time). The Golden Hour planner highlights this slot automatically.'
  },
  {
    q: 'Can I export scheduled meetings directly to Google Calendar, Outlook, or Apple Calendar?',
    a: 'Yes! Once you pick a time slot in the Golden Hour Meeting Planner, click "Add to Google Calendar" or "Add to Outlook" for an instant pre-filled event link, or click "Download .ICS File" for Apple Calendar and other desktop calendar apps.'
  },
  {
    q: 'How does the 24-hour horizontal timeline slider work?',
    a: 'The 24-hour timeline slider acts as a synchronized master scrubber. When you drag the slider or click any hour block, the local time, date (+1/-1 day), and working status update simultaneously across all selected cities on both the timeline and the world map.'
  },
  {
    q: 'How do I switch between the Timeline, Meeting Planner, and Pairwise Converter?',
    a: 'Use the view switcher tabs at the top of the tool. Click "24-Hour Timeline & World Map" for visual scrubbing, "Golden Hour Meeting Planner" for team scheduling and calendar exports, or "Direct Timezone Converter" for rapid two-city calculations.'
  },
  {
    q: 'Does the converter automatically adjust for Daylight Saving Time (DST)?',
    a: 'Yes. Our engine uses standard IANA timezone definitions and native browser date resolution. It automatically accounts for whether a region is currently observing Daylight Saving Time (e.g., EDT/PDT/BST) or Standard Time (EST/PST/GMT).'
  },
  {
    q: 'What does the UTC offset (e.g. UTC+5:30 or UTC-5) mean?',
    a: 'The UTC offset measures how many hours and minutes a location is ahead (+) or behind (-) Coordinated Universal Time (UTC). For example, London is UTC+0 (or UTC+1 during British Summer Time), New York is UTC-5 (or UTC-4 during daylight time), and Mumbai is UTC+5:30.'
  },
  {
    q: 'Why do some timezones have half-hour or 45-minute offsets?',
    a: 'While most time zones use whole-hour offsets from UTC, several countries and regions utilize half-hour or 45-minute offsets for solar alignment or historical reasons, such as India (UTC+5:30), Iran (UTC+3:30), Adelaide (UTC+9:30), and Nepal (UTC+5:45).'
  },
  {
    q: 'What does +1 Day or -1 Day on a city badge mean?',
    a: 'When converting times across significant time differences (like Los Angeles and Tokyo), the local date in the destination city may be on the next calendar day (+1 Day) or previous day (-1 Day) relative to the reference time.'
  },
  {
    q: 'What is the best timezone reference to use for international teams?',
    a: 'Using UTC (Coordinated Universal Time) as a shared baseline is the international standard for globally distributed remote teams, airlines, software systems, and astronomical scheduling because it never changes for Daylight Saving Time.'
  }
];

// JSON-LD Structured Data for Rich Snippets
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<BaseLayout 
  title="24-Hour World Time Zone Converter & Golden Hour Meeting Planner" 
  description="Interactive 24-hour horizontal timeline slider, Golden Hour meeting planner for remote teams, and world map time zone converter. Find overlapping working hours across multiple global cities simultaneously."
  keywords="time zone converter, golden hour meeting planner, remote team meeting scheduler, best meeting time between london and tokyo, 24 hour timezone slider, world time map, interactive timeline slider, time difference calculator, multiple time zone converter, world time buddy alternative"
>

  <!-- Inject JSON-LD Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <!-- ─── Hero ─── -->
  <div style="background:var(--color-surface-soft); border-bottom:1px solid var(--color-hairline-soft); padding:var(--spacing-section) var(--spacing-base);">
    <div style="max-width:var(--width-page); margin:0 auto; text-align:center;">
      <h1 style="font-size:34px; font-weight:800; color:var(--color-ink); line-height:1.2; margin-bottom:var(--spacing-sm);">
        24-Hour World Time Zone Converter &amp; Meeting Planner
      </h1>
      <p style="font-size:18px; color:var(--color-muted); line-height:1.6; max-width:680px; margin:0 auto var(--spacing-lg) auto;">
        Compare global cities simultaneously, find overlapping "Golden Hours" for remote team meetings, and schedule across time zones with one click.
      </p>

      <!-- Feature pills -->
      <div class="flex flex-wrap justify-center gap-2">
        {features.map(f => (
          <span style="display:inline-flex; align-items:center; gap:6px; background:var(--color-canvas); border:1px solid var(--color-hairline); border-radius:var(--radius-full); padding:6px 14px; font-size:13px; font-weight:600; color:var(--color-body);" class="shadow-card">
            <svg width="8" height="8" viewBox="0 0 8 8" fill="var(--color-rausch)" aria-hidden="true"><circle cx="4" cy="4" r="4"/></svg>
            {f}
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── Interactive Views: 3-Way Switcher Tabs ─── -->
  <div class="max-w-[1440px] mx-auto px-3 sm:px-6 lg:px-8 pt-8">
    <div class="inline-flex flex-wrap p-1 rounded-xl bg-[var(--color-surface-soft)] border border-[var(--color-hairline)] shadow-sm gap-1">
      <button id="tab-timeline-btn" class="px-4 sm:px-5 py-2.5 rounded-lg text-sm font-bold transition-all cursor-pointer bg-[var(--color-canvas)] text-[var(--color-rausch)] shadow-sm flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        24-Hour Timeline &amp; Map
      </button>

      <button id="tab-planner-btn" class="px-4 sm:px-5 py-2.5 rounded-lg text-sm font-semibold transition-all cursor-pointer text-[var(--color-muted)] hover:text-[var(--color-ink)] flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
        🤝 Golden Hour Meeting Planner
      </button>

      <button id="tab-converter-btn" class="px-4 sm:px-5 py-2.5 rounded-lg text-sm font-semibold transition-all cursor-pointer text-[var(--color-muted)] hover:text-[var(--color-ink)] flex items-center gap-2">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="17 1 21 5 17 9"></polyline>
          <path d="M3 11V9a4 4 0 0 1 4-4h14"></path>
          <polyline points="7 23 3 19 7 15"></polyline>
          <path d="M21 13v2a4 4 0 0 1-4 4H3"></path>
        </svg>
        Direct Pair Converter
      </button>
    </div>
  </div>

  <!-- ─── View 1: Timeline Slider ─── -->
  <div id="view-timeline" class="block">
    <TimelineSlider />
  </div>

  <!-- ─── View 2: Golden Hour Meeting Planner ─── -->
  <div id="view-planner" class="hidden">
    <MeetingPlanner />
  </div>

  <!-- ─── View 3: Direct Converter ─── -->
  <div id="view-converter" class="hidden">
    <TimezoneConverter />
  </div>

  <!-- ─── How it works ─── -->
  <div style="background:var(--color-surface-soft); border-top:1px solid var(--color-hairline-soft); padding:var(--spacing-section) var(--spacing-base);">
    <div style="max-width:var(--width-page); margin:0 auto;">
      <div class="text-center mb-10">
        <span style="font-size:12px; font-weight:700; color:var(--color-rausch); text-transform:uppercase; letter-spacing:0.08em; display:block; margin-bottom:4px;">Workflow</span>
        <h2 style="font-size:26px; font-weight:800; color:var(--color-ink);">How It Works</h2>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {steps.map(({ step, title, body }) => (
          <div class="shadow-card" style="background:var(--color-canvas); border:1px solid var(--color-hairline); border-radius:var(--radius-lg); padding:var(--spacing-lg);">
            <div style="width:36px; height:36px; border-radius:var(--radius-full); background:var(--color-rausch); color:white; font-size:14px; font-weight:800; display:flex; align-items:center; justify-content:center; margin-bottom:var(--spacing-md);">
              {step}
            </div>
            <h3 style="font-size:17px; font-weight:700; color:var(--color-ink); margin-bottom:6px;">{title}</h3>
            <p style="font-size:14px; color:var(--color-muted); line-height:1.5;">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── Page links ─── -->
  <div style="padding:var(--spacing-section) var(--spacing-base);">
    <div style="max-width:var(--width-page); margin:0 auto;">
      <h2 style="font-size:21px; font-weight:700; color:var(--color-ink); margin-bottom:var(--spacing-lg);">Explore TimeZoneCal</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {pageLinks.map(({ href, label, sub }) => (
          <a href={href} class="page-link-card" style="display:block; background:var(--color-canvas); border:1px solid var(--color-hairline); border-radius:var(--radius-lg); padding:var(--spacing-lg); text-decoration:none; transition:border-color 0.15s, box-shadow 0.15s;">
            <div style="font-size:16px; font-weight:600; color:var(--color-ink); margin-bottom:4px;">{label}</div>
            <div style="font-size:14px; color:var(--color-muted);">{sub}</div>
            <div style="margin-top:var(--spacing-md); font-size:14px; font-weight:500; color:var(--color-rausch); display:flex; align-items:center; gap:4px; opacity:0; transition:opacity 0.15s;" class="link-arrow">
              View page
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── FAQ Section ─── -->
  <div style="padding:var(--spacing-section) var(--spacing-base); border-top:1px solid var(--color-hairline-soft); background:var(--color-surface-soft);">
    <div style="max-width:var(--width-page); margin:0 auto;">
      <div class="text-center mb-10">
        <span style="font-size:12px; font-weight:700; color:var(--color-rausch); text-transform:uppercase; letter-spacing:0.08em; display:block; margin-bottom:4px;">Knowledge Base</span>
        <h2 style="font-size:26px; font-weight:800; color:var(--color-ink);">Frequently Asked Questions</h2>
      </div>
      
      <div class="flex flex-col gap-5">
        {faqItems.map(({ q, a }) => (
          <div class="shadow-card" style="background:var(--color-canvas); border:1px solid var(--color-hairline); border-radius:var(--radius-md); padding:var(--spacing-lg);">
            <h3 style="font-size:16px; font-weight:700; color:var(--color-ink); margin-bottom:var(--spacing-xs);">{q}</h3>
            <p style="font-size:14.5px; color:var(--color-body); line-height:1.6;">{a}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ─── SEO Content Section ─── -->
  <div style="border-top:1px solid var(--color-hairline-soft); padding:var(--spacing-section) var(--spacing-base);">
    <div style="max-width:var(--width-page); margin:0 auto; color:var(--color-body); line-height:1.8;">
      <h2 style="font-size:26px; font-weight:800; color:var(--color-ink); margin-bottom:var(--spacing-lg);">The Modern 24-Hour World Time Zone Converter</h2>
      
      <p style="margin-bottom:var(--spacing-base);">
        Coordinating meetings, broadcasts, and operations across global timezones used to require tedious mental arithmetic and constant calendar cross-referencing. <strong>TimeZoneCal</strong> solves this challenge with a powerful <strong>24-hour horizontal timeline slider</strong> and synchronized <strong>world map visualization</strong>, designed specifically for distributed teams, international businesses, digital nomads, and remote professionals.
      </p>

      <h3 style="font-size:20px; font-weight:700; color:var(--color-ink); margin-top:var(--spacing-xl); margin-bottom:var(--spacing-md);">Simultaneous Multi-City Time Comparison</h3>
      <p style="margin-bottom:var(--spacing-base);">
        Traditional time converters only let you compare two locations at once. Our <strong>multiple time zone converter</strong> lets you stack and view all your key cities in parallel—such as New York, London, Tokyo, San Francisco, Dubai, and Sydney. When you drag the 24-hour scrubber, every city’s clock, day difference (+1 or -1 day), and map pin badge shifts in complete synchronization.
      </p>

      <h3 style="font-size:20px; font-weight:700; color:var(--color-ink); margin-top:var(--spacing-xl); margin-bottom:var(--spacing-md);">Visual Working Hours &amp; Meeting Overlap Finder</h3>
      <p style="margin-bottom:var(--spacing-base);">
        Finding the "golden hour" for team meetings is effortless. Each city track displays clear color-coded indicators: <strong>Green for Business Hours (9:00 AM – 5:00 PM)</strong>, <strong>Amber for Personal / Awake Hours</strong>, and <strong>Slate for Night / Sleep</strong>. You can instantly spot overlapping green windows where everyone is awake and available for collaboration.
      </p>

      <h3 style="font-size:20px; font-weight:700; color:var(--color-ink); margin-top:var(--spacing-xl); margin-bottom:var(--spacing-md);">Interactive Political World Map with Live Time Pins</h3>
      <p style="margin-bottom:var(--spacing-base);">
        Visualizing geography is essential when planning global projects. Our interactive world map shows exact geographical pin locations for all selected cities, complete with live converted time badges and country borders. Tapping any pin on the map instantly highlights and scrolls to that city's timeline track.
      </p>

      <h3 style="font-size:20px; font-weight:700; color:var(--color-ink); margin-top:var(--spacing-xl); margin-bottom:var(--spacing-md);">Accurate Daylight Saving Time (DST) Awareness</h3>
      <p style="margin-bottom:var(--spacing-base);">
        Daylight Saving Time transitions occur on different calendar dates across North America, Europe, Australia, and other regions, often causing unexpected scheduling errors. <strong>TimeZoneCal</strong> natively calculates seasonal DST transitions using the official IANA database, ensuring 100% accurate time conversions 365 days a year.
      </p>

      <h3 style="font-size:20px; font-weight:700; color:var(--color-ink); margin-top:var(--spacing-xl); margin-bottom:var(--spacing-md);">Key Features of TimeZoneCal</h3>
      <ul style="margin-bottom:var(--spacing-lg); padding-left:var(--spacing-lg); list-style-type: disc;">
        <li style="margin-bottom:var(--spacing-xs);"><strong>24-Hour Draggable Timeline:</strong> Drag anywhere across the 24-hour scale to shift hours simultaneously across all cities.</li>
        <li style="margin-bottom:var(--spacing-xs);"><strong>Interactive World Map:</strong> Pinned city badges with real-time converted local times and country boundaries.</li>
        <li style="margin-bottom:var(--spacing-xs);"><strong>Meeting Overlap Indicator:</strong> Live status assessing whether all selected locations are within business hours.</li>
        <li style="margin-bottom:var(--spacing-xs);"><strong>Direct Pairwise Converter:</strong> Dedicated dropdown converter for fast two-city conversions, date selections, and quick presets.</li>
        <li style="margin-bottom:var(--spacing-xs);"><strong>Light &amp; Dark Theme Support:</strong> Seamless aesthetic switching with persistent local storage.</li>
        <li style="margin-bottom:var(--spacing-xs);"><strong>Zero Sign-Up &amp; Privacy First:</strong> No logins, no tracking, and 100% free forever.</li>
      </ul>
    </div>
  </div>

</BaseLayout>

<script>
  const tabTimelineBtn = document.getElementById('tab-timeline-btn');
  const tabPlannerBtn = document.getElementById('tab-planner-btn');
  const tabConverterBtn = document.getElementById('tab-converter-btn');

  const viewTimeline = document.getElementById('view-timeline');
  const viewPlanner = document.getElementById('view-planner');
  const viewConverter = document.getElementById('view-converter');

  const allTabs = [
    { btn: tabTimelineBtn, view: viewTimeline },
    { btn: tabPlannerBtn, view: viewPlanner },
    { btn: tabConverterBtn, view: viewConverter }
  ];

  function switchTab(activeTab: { btn: HTMLElement | null, view: HTMLElement | null }) {
    allTabs.forEach(({ btn, view }) => {
      if (btn === activeTab.btn) {
        view?.classList.remove('hidden');
        view?.classList.add('block');
        btn?.classList.add('bg-[var(--color-canvas)]', 'text-[var(--color-rausch)]', 'shadow-sm');
        btn?.classList.remove('text-[var(--color-muted)]');
      } else {
        view?.classList.add('hidden');
        view?.classList.remove('block');
        btn?.classList.remove('bg-[var(--color-canvas)]', 'text-[var(--color-rausch)]', 'shadow-sm');
        btn?.classList.add('text-[var(--color-muted)]');
      }
    });
  }

  tabTimelineBtn?.addEventListener('click', () => switchTab(allTabs[0]));
  tabPlannerBtn?.addEventListener('click', () => switchTab(allTabs[1]));
  tabConverterBtn?.addEventListener('click', () => switchTab(allTabs[2]));
</script>

<style>
  .page-link-card:hover {
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-card);
  }
  .page-link-card:hover .link-arrow {
    opacity: 1;
  }
</style>

